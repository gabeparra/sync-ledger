# Sync-Ledger configuration
SYNC_LEDGER_DATABASE_URL=postgresql+psycopg://sync_ledger:sync_ledger@localhost:5432/sync_ledger
SYNC_LEDGER_WEBHOOK_SECRET=dev-shared-webhook-secret-change-me
# Optional per-source JSON map of HMAC secrets:
# SYNC_LEDGER_SOURCE_SECRETS={"crm":"crm-secret","billing":"billing-secret","erp":"erp-secret"}
SYNC_LEDGER_SIGNATURE_TOLERANCE_SECONDS=300
SYNC_LEDGER_OUTBOX_BATCH_SIZE=25
SYNC_LEDGER_OUTBOX_POLL_INTERVAL_SECONDS=1.0
SYNC_LEDGER_RETRY_MAX_ATTEMPTS=4
SYNC_LEDGER_RETRY_BASE_DELAY_SECONDS=2.0
SYNC_LEDGER_RETRY_MAX_DELAY_SECONDS=60.0
SYNC_LEDGER_LOG_LEVEL=INFO
SYNC_LEDGER_WORKER_ID=worker-local-1
# Seconds before another worker may reclaim a 'processing' message from a dead worker
SYNC_LEDGER_OUTBOX_LEASE_TIMEOUT_SECONDS=300
